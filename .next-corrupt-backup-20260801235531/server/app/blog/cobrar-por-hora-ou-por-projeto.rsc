\":\"Organization\",\"name\":\"Tropa\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Tropa\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Posso cobrar por hora e ainda assim dar um valor estimado ao cliente?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim, e é recomendado. Mesmo cobrando por hora, é possível (e saudável) dar uma faixa estimada de horas e valor total ao cliente, com base em projetos parecidos anteriores — isso reduz a sensação de imprevisibilidade sem abrir mão da flexibilidade do modelo.\"}},{\"@type\":\"Question\",\"name\":\"Como sei quanto vale a minha hora de trabalho?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Uma forma prática: defina quanto quer ganhar por mês, divida pelos dias que trabalha e pelas horas úteis de cada dia. Isso dá um valor-hora de referência, que pode ser ajustado conforme a complexidade de cada tipo de serviço.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Blog\",\"item\":\"/blog\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Cobrar por hora ou por projeto fechado: como decidir\",\"item\":\"/blog/cobrar-por-hora-ou-por-projeto\"}]}"}}]],["$","section",null,{"className":"blog-article-section","aria-labelledby":"blog-article-title","children":[["$","nav",null,{"className":"blog-breadcrumb","aria-label":"Caminho","children":[["$","a",null,{"href":"/blog","children":"Blog"}],["$","span",null,{"aria-hidden":"true","children":"/"}],["$","span",null,{"children":"Precificação"}]]}],["$","header",null,{"className":"blog-hero-banner","children":[["$","img",null,{"className":"blog-hero-banner-bg","src":"/blog/covers/cobrar-por-hora-ou-por-projeto.jpg","alt":"Mesa de