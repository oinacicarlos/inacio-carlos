on\",\"name\":\"Tropa\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Tropa\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Vale a pena entrar na justiça por um valor pequeno?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Para valores menores, o Juizado Especial Cível costuma ser o caminho mais viável: é mais rápido, mais barato e, até um certo limite de valor, não exige advogado. Vale pesar o tempo e o esforço envolvidos contra o valor em disputa antes de decidir.\"}},{\"@type\":\"Question\",\"name\":\"Um print de conversa serve como prova de que o serviço foi combinado?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Pode ajudar como evidência complementar, mas não substitui um contrato formal — é mais fácil de contestar e não deixa tão claro todos os termos combinados. Sempre que possível, formalizar por contrato (mesmo simples) é mais seguro.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Blog\",\"item\":\"/blog\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"O que fazer quando o cliente não paga pelo serviço\",\"item\":\"/blog/o-que-fazer-quando-cliente-nao-paga\"}]}"}}]],["$","section",null,{"className":"blog-article-section","aria-labelledby":"blog-article-title","children":[["$","nav",null,{"className":"blog-breadcrumb","aria-label":"Caminho","children":[["$","a",null,{"href":"/blog","children":"Blog"}],["$","span",null,{"aria-hidden":"true","children":"/"}],["$","span",null,{"children":"Contratos"}]]}],["$","header",null,{"className":"blog-hero-banner","children":[["$","img",null,{"className":"blog-hero-banner-bg","src":"/blog/covers/o-que-fazer-quando-cliente-nao-paga.jpg","alt":"Mulher preocupad