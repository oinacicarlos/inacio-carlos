iv",null,{"className":"blog-card-footer","children":[["$","span",null,{"children":["16 de fevereiro de 2026"," · ",6," min de leitura"]}],["$","$L10",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:0:props:children:4:props:children:1:props:iconNode","className":"lucide-arrow-right","size":18,"strokeWidth":2.2,"aria-hidden":"true"}]]}]]}],["$","a","como-calcular-decimo-terceiro-salario",{"className":"blog-card","href":"/blog/como-calcular-decimo-terceiro-salario","children":[["$","div",null,{"className":"blog-cover blog-cover--card","children":["$","img",null,{"src":"/blog/covers/como-calcular-decimo-terceiro-salario.jpg","alt":"Mulher sorrindo segurando dinheiro e um envelope","loading":"lazy"}]}],["$","span",null,{"className":"blog-card-pillar","children":"Contratação de funcionários"}],["$","h3",null,{"children":"Como calcular o 13º salário passo a passo"}],["$","p",null,{"children":"O 13º salário parece simples até a hora de calcular direito — primeira parcela, segunda parcela, descontos. Veja o passo a passo com exemplo prático."}],["$","div",null,{"className":"blog-card-footer","children":[["$","span",null,{"children":["13 de fevereiro de 2026"," · ",6," min de leitura"]}],["$","$L10",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:0:props:children:4:props:children:1:props:iconNode","className":"lucide-arrow-right","size":18,"strokeWidth":2.2,"aria-hidden":"true"}]]}]]}]]}]]}]
