ization\",\"name\":\"Tropa\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Tropa\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"O aviso prévio é descontado do FGTS?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Não. O aviso prévio, seja trabalhado ou indenizado, integra a remuneração para efeito de FGTS e demais verbas — inclusive conta como tempo de serviço para o cálculo de 13º e férias proporcionais, mesmo quando indenizado.\"}},{\"@type\":\"Question\",\"name\":\"Posso ser dispensado de cumprir o aviso prévio quando peço demissão?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim, mas depende da empresa concordar. Se a empresa dispensar o cumprimento, o funcionário não precisa trabalhar os 30 dias, mas também não recebe o valor correspondente de forma indenizada — diferente de quando é a empresa que demite.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Blog\",\"item\":\"/blog\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"O que é aviso prévio e como ele funciona na prática\",\"item\":\"/blog/o-que-e-aviso-previo-como-funciona\"}]}"}}]],["$","section",null,{"className":"blog-article-section","aria-labelledby":"blog-article-title","children":[["$","nav",null,{"className":"blog-breadcrumb","aria-label":"Caminho","children":[["$","a",null,{"href":"/blog","children":"Blog"}],["$","span",null,{"aria-hidden":"true","children":"/"}],["$","span",null,{"children":"Rescisão e direitos trabalhistas"}]]}],["$","header",null,{"className":"blog-hero-banner","children":[["$","img",null,{"className":"blog-hero-banner-bg","src":"/blog/covers/o-que-e-aviso-previo-como-funciona.jpg","alt":"Mulher planejando a agenda e