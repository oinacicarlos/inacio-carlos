{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "inacio-carlos",
  "compatibility_date": "2026-05-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "inacio-carlos"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://tropacontabilidade.com",
    "RESEND_FROM": "Tropa <contato@tropacontabilidade.com>",
    "STRIPE_PRICE_ABERTURA_EMPRESA": "price_1U0X7K7im61UN4ESP8HC4jO9",
    "STRIPE_PRICE_ALTERACAO_CNPJ": "price_1U0X6F7im61UN4ESn8KQz2Tl",
    "STRIPE_PRICE_BRONZE": "price_1U0X3K7im61UN4ES3YTNMBEo",
    "STRIPE_PRICE_CERTIFICADO_A1": "price_1U0X4g7im61UN4ESdyUvrGDM",
    "STRIPE_PRICE_CERTIFICADO_PF_A1": "price_1U0X4V7im61UN4ESztolOP2e",
    "STRIPE_PRICE_DIAMANTE": "price_1U0X437im61UN4ESF4CTrpIJ",
    "STRIPE_PRICE_NOTA_FISCAL_PRODUTO": "price_1U0X807im61UN4ESL7FsU3le",
    "STRIPE_PRICE_NOTA_FISCAL_SERVICO": "price_1U0X7o7im61UN4ESNhsBGYQb",
    "STRIPE_PRICE_OURO": "price_1U0X3t7im61UN4ESxhUcz3xK",
    "STRIPE_PRICE_PRATA": "price_1U0X3f7im61UN4ESFXkoEf8V",
    "STRIPE_PRICE_SERASA_PF": "price_1U0X5C7im61UN4ESR3BOalSH",
    "STRIPE_PRICE_SERASA_PJ": "price_1U0X527im61UN4ESaukNdLNv"
  }
}
